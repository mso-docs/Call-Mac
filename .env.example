# OPTIONAL: Local Ollama works without this file.
# To customize: copy this file to .env in the same folder as app.py.
# Edit .env, save, then stop and restart Call Mac.
# Keep private server addresses in .env only. Do not edit this shared template.

# Primary Ollama server. 127.0.0.1 means the computer running Call Mac.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model to use. Download it first with: ollama pull gemma3:4b
CALL_MAC_MODEL=gemma3:4b

# Optional backup server: uncomment and replace with your own server address.
# OLLAMA_SECONDARY_URL=http://your-ollama-server:11434

# Advanced primary override; takes precedence over OLLAMA_BASE_URL.
# CALL_MAC_OLLAMA_URL=http://127.0.0.1:11434

# Optional database location. Leave commented to use data/call_mac.db.
# CALL_MAC_DB=data/call_mac.db
